            {{ country }}
          </option>
        {% endfor %}
      </select>

      <button type="submit" class="bg-secondary text-white px-4 py-2 rounded">Filtrer</button>
    </form>
  </div> #}

  {% if jobs|length == 0 %}
    <p class="text-gray-500">Aucune offre ne correspond à vos critères.</p>
  {% endif %}

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    {% for job in jobs %}
      <div class="bg-white p-4 rounded shadow">
        <h3 class="font-bold text-lg">{{ job.title }}</h3>
        <p class="text-sm text-gray-600">{{ job.company }} – {{ job.country }}</p>
        <a href="{{ path('job_show', { id: job.id }) }}" class="text-secondary mt-2 inline-block">Voir plus</a>
      </div>
    {% endfor %}
  </div>

  {# {% if pagination is defined %}
    <div class="mt-6">
      {{ knp_pagination_render(pagination) }}
    </div>
  {% endif %} #}
{% endblock %}
