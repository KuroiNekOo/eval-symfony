{% extends 'base.html.twig' %}

{% block title %}{{ offer.title }}{% endblock %}

{% block body %}
  <div class="bg-white p-6 rounded shadow">
    <h1 class="text-3xl font-bold mb-2">{{ offer.title }}</h1>
    <p class="text-gray-600">
      {{ offer.company.name }} – {{ offer.city }}, {{ offer.country }}
    </p>

    <p class="mt-4 whitespace-pre-line">{{ offer.description }}</p>
  </div>

  {% if app.user %}
    <div class="mt-6 bg-gray-100 p-4 rounded">
      <h2 class="text-xl font-semibold mb-2">Postuler à cette offre</h2>
      <form method="post" action="{{ path('apply_offer', { id: offer.id }) }}">
        <input type="hidden" name="_token" value="{{ csrf_token('apply_offer' ~ offer.id) }}">

        <textarea name="motivation" class="w-full p-2 border rounded mb-3" rows="6"
                  placeholder="Votre lettre de motivation..."></textarea>

        <button type="submit" class="bg-secondary text-white px-4 py-2 rounded">
          Envoyer ma candidature
        </button>
      </form>
    </div>
  {% else %}
    <p class="mt-4 text-sm text-gray-700">
      <a href="{{ path('app_login') }}" class="text-secondary underline">Connectez-vous</a>
      pour postuler à cette offre.
    </p>
  {% endif %}
{% endblock %}
