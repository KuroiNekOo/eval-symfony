<turbo-frame id="job-form">
      <form method="post" action="{{ path('app_application_job_form', { id: job.id }) }}" data-turbo-frame="job-form">
        <textarea name="job_application_type_form[coverLetter]" class="w-full p-2 border rounded mb-3" rows="6"
                  placeholder="Votre lettre de motivation..."></textarea>

        <button type="submit" class="bg-secondary text-white px-4 py-2 rounded">
          Envoyer ma candidature
        </button>
        {{ form_row(form._token) }}
      </form>
</turbo-frame>