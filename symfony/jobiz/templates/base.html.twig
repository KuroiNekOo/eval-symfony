<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8">
    <title>{% block title %}Welcome!{% endblock %}</title>

    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">

    {% block stylesheets %}{% endblock %}

    {% block javascripts %}
      {% block importmap %}
        {{ importmap('app') }}
      {% endblock %}
    {% endblock %}
  </head>

  <body class="bg-gray-100 text-gray-900">
    <header class="text-gray-100 bg-primary body-font">
      <div class="container mx-auto flex flex-wrap p-5 flex-col md:flex-row items-center">
        <a class="flex title-font font-medium items-center text-white mb-4 md:mb-0" href="#">
          <img width="120" src="{{ asset('images/logo-jobiz.png') }}" alt="jobiz">
        </a>

        <nav class="md:ml-auto md:mr-auto flex flex-wrap items-center text-base justify-center">
          <a class="mr-5 hover:text-white" href="{{ path('app_home') }}">Home</a>
          <a class="mr-5 hover:text-white" href="{{ path('app_about') }}">About</a>
          <a class="mr-5 hover:text-white" href="{{ path('app_job_list') }}">Offres</a>
         
        </nav>

        <div class="flex md:flex-nowrap flex-wrap justify-center items-end md:justify-start px-3">
          <div class="relative sm:w-64 w-40 sm:mr-4 mr-2">
            <input placeholder="Search" type="text" id="footer-field" name="footer-field"
              class="w-full bg-gray-800 bg-opacity-40 rounded border border-gray-700 focus:ring-2 focus:ring-secondary focus:bg-transparent focus:border-secondary text-base outline-none text-gray-100 py-1 px-3 leading-8 transition-colors duration-200 ease-in-out">
          </div>
          <button class="inline-flex text-white bg-secondary border-0 py-2 px-6 focus:outline-none hover:bg-teal-700 rounded">OK</button>
        </div>

        <a class="inline-flex items-center bg-gray-800 border-0 py-2 px-3 ml-10 focus:outline-none hover:bg-gray-700 rounded text-base mt-4 md:mt-0" href="#">Login</a>
      </div>
    </header>

  
    {% block body %}{% endblock %}

    <footer class="text-gray-400 bg-primary body-font">
      <div class="container px-5 py-8 mx-auto flex items-center sm:flex-row flex-col">
        <a class="flex title-font font-medium items-center md:justify-start justify-center text-white" href="#">
          <img width="70" src="{{ asset('images/logo-jobiz.png') }}" alt="Jobiz">
        </a>
        <p class="text-sm text-gray-400 sm:ml-4 sm:pl-4 sm:border-l-2 sm:border-gray-800 sm:py-2 sm:mt-0 mt-4">
          © {{ 'now' | date('Y') }} Jobiz
        </p>
        <span class="inline-flex sm:ml-auto sm:mt-0 mt-4 justify-center sm:justify-start">
      
          <a class="text-gray-400" href="#"><svg fill="currentColor" class="w-5 h-5" viewBox="0 0 24 24"><path d="M18 2h-3a5 5 0..."></path></svg></a>
          <a class="ml-3 text-gray-400" href="#"><svg fill="currentColor" class="w-5 h-5" viewBox="0 0 24 24"><path d="M23 3a10.9..."></path></svg></a>
          <a class="ml-3 text-gray-400" href="#"><svg fill="none" stroke="currentColor" class="w-5 h-5" viewBox="0 0 24 24"><rect width="20" ...></rect><path d="M16 11.37..."></path></svg></a>
          <a class="ml-3 text-gray-400" href="#"><svg fill="currentColor" stroke="currentColor" class="w-5 h-5" viewBox="0 0 24 24"><path d="M16 8a6 6..."></path><circle cx="4" cy="4" r="2"></circle></svg></a>
        </span>
      </div>
    </footer>
  </body>
</html>
